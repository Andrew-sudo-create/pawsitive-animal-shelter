rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Self-register as admin (doc id must be the signed-in UID)
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dogs/{dogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /people/{personId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public can submit contact forms; only admins can read/manage
    match /contact_messages/{messageId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.message is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 200
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 320
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 5000;
      allow read, update, delete: if isAdmin();
    }
  }
}
